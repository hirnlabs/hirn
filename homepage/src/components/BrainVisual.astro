---
import { getCollection } from "astro:content";
import BrainIcon from "./BrainIcon.astro";
import ServiceIcon from "./ServiceIcon.astro";

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

// Fetch all service entries for the given language
const services = await getCollection("services", (entry) =>
  entry.id.startsWith(`${lang}/`) && !entry.id.endsWith("/values")
);

// Standard angles for 3-left / 3-right distribution with natural top & bottom spacing
const PREFERRED_ANGLES: Record<string, number> = {
  router: -120,   // Top Left
  learn: 180,     // Center Left
  desktop: 120,   // Bottom Left
  agent: -60,     // Top Right
  server: 0,      // Center Right
  assistant: 60,  // Bottom Right
};

const maxRadius = 40; // Percentage radius from center (50, 50)
const prefix = lang === "de" ? "/de" : "";

const nodeItems = services.map((service, index) => {
  const slug = service.id.split("/")[1];
  
  // Use preferred angle if defined, otherwise fallback to standard left/right split angle
  let angleDeg = PREFERRED_ANGLES[slug];
  if (angleDeg === undefined) {
    const isLeft = index % 2 === 0;
    const sideIndex = Math.floor(index / 2);
    angleDeg = isLeft ? 180 + (sideIndex - 1) * 60 : (sideIndex - 1) * 60;
  }

  const angleRad = (angleDeg * Math.PI) / 180;
  const x = Math.round((50 + maxRadius * Math.cos(angleRad)) * 100) / 100;
  const y = Math.round((50 + maxRadius * Math.sin(angleRad)) * 100) / 100;

  return {
    slug,
    title: service.data.title,
    description: service.data.description,
    icon: service.data.icon,
    href: `${prefix}/${slug}`,
    x,
    y,
    angleDeg,
  };
});
---

<!-- BrainVisual.astro -->
<div class="relative aspect-square w-full max-w-[360px] mx-auto my-4 flex items-center justify-center select-none brain-visual-container">
  
  <!-- Dynamic SVG Connecting Lines & Orbital Rings -->
  <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full pointer-events-none z-0">
    <!-- Orbital guide rings -->
    <circle cx="50" cy="50" r="26" fill="none" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="3 3" class="opacity-40" />
    <circle cx="50" cy="50" r={maxRadius} fill="none" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="6 6" class="opacity-25" />

    <!-- Connecting lines to dynamic nodes -->
    {nodeItems.map((node) => (
      <line
        id={`line-${node.slug}`}
        x1="50"
        y1="50"
        x2={node.x}
        y2={node.y}
        stroke="var(--color-border)"
        stroke-width="1"
        class="transition-all duration-300 opacity-40 dark:opacity-30 brain-connect-line"
      />
    ))}
  </svg>

  <!-- Central Prominent Brain Hub -->
  <div class="relative z-10 p-6 bg-surface rounded-full border border-border shadow-xl transition-all duration-500 hover:scale-105 hover:border-accent/50 group/brain cursor-pointer">
    <div class="relative flex items-center justify-center">
      <div class="absolute -inset-3 rounded-full bg-accent/10 blur-xl opacity-60 group-hover/brain:opacity-100 transition-opacity"></div>
      <BrainIcon variant="outline" size={84} class="relative z-10 animate-brain-pulse text-primary transition-transform duration-300 group-hover/brain:scale-105" />
    </div>
  </div>

  <!-- Dynamic Orbiting Component Nodes (3 Left, 3 Right) -->
  {nodeItems.map((node, i) => (
    <div
      class="absolute z-20 group brain-node-wrapper"
      style={`left: ${node.x}%; top: ${node.y}%; transform: translate(-50%, -50%); animation-delay: ${i * 80}ms;`}
      data-slug={node.slug}
    >
      <a
        href={node.href}
        id={`node-${node.slug}`}
        class={`flex flex-col items-center gap-1 transition-all duration-300 hover:scale-110 text-secondary group-hover:text-primary animate-float-node-${(i % 6) + 1}`}
      >
        <div class="bg-surface rounded-full p-2.5 relative z-20 border border-border shadow-sm group-hover:border-accent/40 group-hover:shadow-md transition-all">
          <ServiceIcon name={node.icon} class="h-5 w-5 text-primary group-hover:text-accent transition-colors" />
        </div>
        <span class="font-mono text-xs font-bold tracking-wider transition-colors">{node.title}</span>
      </a>
      <!-- Translated Hover Tooltip -->
      <div class={`absolute ${node.y > 60 ? 'bottom-full mb-2' : 'top-full mt-2'} left-1/2 -translate-x-1/2 w-48 text-center text-[0.6875rem] opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-300 z-30 font-sans leading-normal font-medium bg-surface border border-border p-2.5 rounded-xl shadow-xl text-primary backdrop-blur-md`}>
        {node.description}
      </div>
    </div>
  ))}

</div>

<script>
  function initBrainVisual() {
    const wrappers = document.querySelectorAll('.brain-node-wrapper');
    
    wrappers.forEach((wrapper) => {
      const slug = (wrapper as HTMLElement).dataset.slug;
      const el = document.getElementById(`node-${slug}`);
      const line = document.getElementById(`line-${slug}`);

      if (el && line) {
        el.addEventListener('mouseenter', () => {
          line.setAttribute('stroke', 'var(--color-accent)');
          line.style.opacity = '1';
        });
        el.addEventListener('mouseleave', () => {
          line.setAttribute('stroke', 'var(--color-border)');
          line.style.opacity = '0.4';
        });
      }
    });
  }

  initBrainVisual();
  document.addEventListener('astro:page-load', initBrainVisual);
</script>

<style>
  @keyframes radial-pop {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.15);
    }
    70% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.08);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .brain-node-wrapper {
    animation: radial-pop 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
</style>
