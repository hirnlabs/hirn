---
import Layout from "./Layout.astro";
import ServiceIcon from "./ServiceIcon.astro";
import HighlightCard from "./HighlightCard.astro";
import { ArrowLeft } from "@lucide/astro";

interface Highlight {
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  lead?: string;
  icon?: string;
  highlights?: Highlight[];
  lang?: string;
}

const { title, description, lead, icon, highlights = [], lang = "en" } = Astro.props;

const homeUrl = lang === "de" ? "/de" : "/";
const backText = lang === "de" ? "Zurück zur Systemübersicht" : "Back to system overview";
---

<Layout title={`${title} - hirn`} description={description} lang={lang}>
  <div class="wrap py-12">
    <a href={homeUrl} class="group inline-flex items-center gap-2 mb-8 font-mono text-xs text-secondary hover:text-primary transition-colors">
      <ArrowLeft class="h-4 w-4 transform transition-transform group-hover:-translate-x-0.5" size={16} />
      {backText}
    </a>

    <section class="mb-12 border-b border-border pb-10">
      <div class="flex items-center gap-4 mb-4">
        {icon && (
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-bg">
            <ServiceIcon name={icon} class="h-6 w-6" />
          </div>
        )}
        <h1 class="text-[clamp(2rem,4vw,2.75rem)] font-bold tracking-tight">{title}</h1>
      </div>
      {lead && (
        <p class="text-xl text-secondary max-w-[680px] leading-relaxed">
          {lead}
        </p>
      )}
    </section>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="md:col-span-2 space-y-10 order-2 md:order-1 subpage-markdown">
        <slot />
      </div>

      {highlights.length > 0 && (
        <div class="space-y-4 order-1 md:order-2">
          {highlights.map((item) => (
            <HighlightCard title={item.title} description={item.description} />
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  import mermaid from "mermaid";

  mermaid.initialize({
    startOnLoad: false,
    theme: "dark",
    securityLevel: "loose",
    fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
  });

  async function renderMermaidCharts() {
    const mermaidCodes = document.querySelectorAll(
      ".subpage-markdown pre code.language-mermaid, .subpage-markdown pre.language-mermaid code"
    );

    for (let i = 0; i < mermaidCodes.length; i++) {
      const codeEl = mermaidCodes[i];
      const preEl = codeEl.closest("pre");
      if (!preEl || preEl.dataset.mermaidRendered) continue;
      preEl.dataset.mermaidRendered = "true";

      const chartDefinition = (codeEl.textContent || "").trim();
      const container = document.createElement("div");
      container.className = "mermaid-container my-6 p-6 rounded-2xl border border-border bg-surface/60 shadow-lg overflow-x-auto flex justify-center";
      
      const chartId = `mermaid-chart-${Date.now()}-${i}`;
      
      try {
        const { svg } = await mermaid.render(chartId, chartDefinition);
        container.innerHTML = svg;
        preEl.replaceWith(container);
      } catch (err) {
        console.error("Mermaid render error:", err);
      }
    }
  }

  function initCopyButtons() {
    const preElements = document.querySelectorAll('.subpage-markdown pre');
    preElements.forEach((pre) => {
      if (
        pre.querySelector('.copy-code-btn') ||
        pre.querySelector('code.language-mermaid') ||
        pre.classList.contains('language-mermaid')
      ) {
        return;
      }

      const btn = document.createElement('button');
      btn.className = 'copy-code-btn absolute top-2.5 right-2.5 px-2.5 py-1 text-xs font-mono rounded-md bg-surface hover:bg-border/60 border border-border text-secondary hover:text-primary transition-all duration-200 flex items-center gap-1.5 cursor-pointer shadow-sm';
      btn.type = 'button';
      btn.setAttribute('aria-label', 'Copy code to clipboard');

      btn.innerHTML = `
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span>Copy</span>
      `;

      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = (code ? code.textContent : pre.textContent)?.trim() || "";
        try {
          await navigator.clipboard.writeText(text);
          btn.innerHTML = `
            <svg class="h-3.5 w-3.5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-accent font-semibold">Copied!</span>
          `;
          setTimeout(() => {
            btn.innerHTML = `
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span>Copy</span>
            `;
          }, 2000);
        } catch (err) {
          console.error('Clipboard copy failed:', err);
        }
      });

      pre.appendChild(btn);
    });
  }

  renderMermaidCharts();
  initCopyButtons();
  document.addEventListener('astro:page-load', () => {
    renderMermaidCharts();
    initCopyButtons();
  });
</script>

<style is:global>
  /* Markdown content styling inside subpages */
  .subpage-markdown {
    color: var(--secondary);
    line-height: 1.625;
  }
  .subpage-markdown h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 1rem;
    margin-top: 2rem;
  }
  .subpage-markdown h2:first-child {
    margin-top: 0;
  }
  .subpage-markdown h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.75rem;
    margin-top: 1.5rem;
  }
  .subpage-markdown p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }
  .subpage-markdown p strong {
    color: var(--primary);
    font-weight: 600;
  }
  .subpage-markdown code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 0.125rem 0.25rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    color: var(--primary);
  }
  .subpage-markdown pre {
    position: relative;
    padding: 1rem;
    padding-right: 5rem;
    font-size: 0.875rem;
    font-family: var(--font-mono);
    overflow-x: auto;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    margin-bottom: 1rem;
    color: var(--primary);
  }
  .subpage-markdown pre code {
    background: transparent;
    border: 0;
    padding: 0;
    border-radius: 0;
  }
  .subpage-markdown ul {
    list-style-type: disc;
    list-style-position: outside;
    margin-left: 1.25rem;
    margin-bottom: 1rem;
  }
  .subpage-markdown ol {
    list-style-type: decimal;
    list-style-position: outside;
    margin-left: 1.25rem;
    margin-bottom: 1rem;
  }
  .subpage-markdown li strong {
    color: var(--primary);
    font-weight: 600;
  }
  .mermaid-container svg {
    max-width: 100%;
    height: auto;
  }
</style>
