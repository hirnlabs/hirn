---
import { getEntry } from "astro:content";
import Layout from "../components/Layout.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import BrainVisual from "../components/BrainVisual.astro";
import { Play, Mail } from "@lucide/astro";

const entry = (await getEntry("home", "en")) ?? (await getEntry("home", "en.md"));
if (!entry) {
  throw new Error("Missing home/en content entry");
}
const { data } = entry;
---

<Layout title={data.title} description={data.description} lang="en">

	<!-- Hero Section -->
	<div class="wrap">
		<section class="flex flex-col gap-10 pb-10 pt-12 sm:gap-12 sm:pb-12 sm:pt-16 items-center text-center">

			<!-- Architecture frame with video overlay -->
			<div class="group relative mx-auto w-full max-w-[760px] aspect-video rounded-[15px] overflow-hidden border border-[#171717] bg-[#F0F0F0] p-1 shadow-xl transition-all">
				<img id="hero-img" src="/assets/hirn_architecture.svg" alt={data.hero.architectureAlt} class="w-full h-full object-contain rounded-[12px] bg-[#F0F0F0]" />

				<!-- Video scrim overlay -->
				<div class="absolute inset-1 rounded-[12px] bg-black/0 group-hover:bg-black/20 transition-colors duration-300 pointer-events-none"></div>

				<!-- Play button overlay -->
				<button id="play-btn" class="absolute inset-0 flex flex-col gap-3 w-full cursor-pointer items-center justify-center border-0 bg-transparent" aria-label="Play video">
					<!-- Pulsing glow circle -->
					<div class="relative flex h-16 w-16 items-center justify-center rounded-full bg-white/95 text-primary shadow-2xl transition-all duration-300 group-hover:scale-110 group-hover:bg-primary group-hover:text-white">
						<span class="absolute -inset-3 rounded-full bg-white/30 dark:bg-white/10 animate-slow-pulse group-hover:bg-primary/20"></span>
						<Play class="ml-1 h-6 w-6 transition-colors fill-current" size={24} />
					</div>
				</button>
				<!-- Inline video (hidden until play is clicked) -->
				<iframe id="hero-video" src="about:blank" data-src="https://share.descript.com/embed/nK78GD2h1rj" class="absolute inset-1 w-[calc(100%-8px)] h-[calc(100%-8px)] rounded-[12px]" style="display:none" allowfullscreen></iframe>
			</div>

			<!-- Hero Content -->
			<div class="w-full max-w-[720px] space-y-6">
				<p class="font-mono text-xs font-bold uppercase tracking-widest text-accent">{data.hero.eyebrow}</p>
				<h1 class="text-[clamp(2.25rem,6vw,3.75rem)] leading-[1.05] font-extrabold tracking-tight">
					{data.hero.title}
				</h1>
				<p class="text-secondary text-lg leading-[1.7] max-w-[620px] mx-auto">
					{data.hero.lead}
				</p>

				<WaitlistForm class="mx-auto pt-2" />
			</div>

		</section>
	</div>

	<!-- Why Section -->
	<section class="border-t border-border py-16">
		<div class="wrap">
			<div class="mb-12">
				<p class="mb-4 font-mono text-xs font-bold uppercase tracking-widest text-accent">{data.why.eyebrow}</p>
				<h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-bold tracking-tight mb-4">{data.why.title}</h2>
				<p class="max-w-[680px] leading-[1.7] text-secondary text-[1.125rem]">
					{data.why.description}
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{data.why.reasons.map((reason) => (
					<div class="p-6 rounded-[15px] border border-border bg-surface">
						<h3 class="text-lg font-bold mb-2">{reason.title}</h3>
						<p class="text-sm text-secondary leading-relaxed">
							{reason.description}
						</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- How It Works Section (Graph Index & Agent Memory) -->
	<section class="border-t border-border py-16 bg-surface/10">
		<div class="wrap">
			<div class="mb-12">
				<p class="mb-4 font-mono text-xs font-bold uppercase tracking-widest text-accent">{data.how.eyebrow}</p>
				<h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-bold tracking-tight mb-4">{data.how.title}</h2>
				<p class="max-w-[720px] leading-[1.7] text-secondary text-[1.125rem]">
					{data.how.description}
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{data.how.features.map((feat) => (
					<div class="p-6 rounded-[15px] border border-border bg-surface">
						<h3 class="text-lg font-bold mb-2">{feat.title}</h3>
						<p class="text-sm text-secondary leading-relaxed">
							{feat.description}
						</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Component Showcase / Cards Grid -->
	<section class="border-t border-border bg-surface/20 py-12 transition-colors duration-300">
		<div class="wrap">
			<div class="mb-16 flex flex-col md:flex-row items-center gap-12">
				<div class="flex-1">
					<p class="mb-4 font-mono text-xs font-bold uppercase tracking-widest text-secondary">{data.pillars.eyebrow}</p>
					<h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-bold tracking-tight mb-4">{data.pillars.title}</h2>
					<p class="max-w-[620px] leading-[1.7] text-secondary text-[1.125rem]">
						{data.pillars.description}
					</p>
				</div>
				<div class="flex-1 w-full flex justify-end">
					<BrainVisual lang="en" />
				</div>
			</div>

			<!-- Cards Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				<!-- Agent Card -->
				<a href="/agent" class="group block p-6 transition-all duration-300 hover:-translate-y-1 rounded-[15px] border border-border bg-surface">
					<h3 class="text-lg font-bold group-hover:text-accent transition-colors mb-2">agent</h3>
					<p class="text-sm text-secondary leading-relaxed mb-4">
						{data.pillars.cards.agent.description}
					</p>
					<span class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-primary opacity-60 group-hover:opacity-100 transition-opacity">
						{data.pillars.cards.agent.linkText}
					</span>
				</a>

				<!-- Desktop Card -->
				<a href="/desktop" class="group block p-6 transition-all duration-300 hover:-translate-y-1 rounded-[15px] border border-border bg-surface">
					<h3 class="text-lg font-bold group-hover:text-accent transition-colors mb-2">desktop</h3>
					<p class="text-sm text-secondary leading-relaxed mb-4">
						{data.pillars.cards.desktop.description}
					</p>
					<span class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-primary opacity-60 group-hover:opacity-100 transition-opacity">
						{data.pillars.cards.desktop.linkText}
					</span>
				</a>

				<!-- Assistant Card -->
				<a href="/assistant" class="group block p-6 transition-all duration-300 hover:-translate-y-1 rounded-[15px] border border-border bg-surface">
					<h3 class="text-lg font-bold group-hover:text-accent transition-colors mb-2">assistant</h3>
					<p class="text-sm text-secondary leading-relaxed mb-4">
						{data.pillars.cards.assistant.description}
					</p>
					<span class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-primary opacity-60 group-hover:opacity-100 transition-opacity">
						{data.pillars.cards.assistant.linkText}
					</span>
				</a>

				<!-- Server Card -->
				<a href="/server" class="group block p-6 transition-all duration-300 hover:-translate-y-1 rounded-[15px] border border-border bg-surface">
					<h3 class="text-lg font-bold group-hover:text-accent transition-colors mb-2">server</h3>
					<p class="text-sm text-secondary leading-relaxed mb-4">
						{data.pillars.cards.server.description}
					</p>
					<span class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-primary opacity-60 group-hover:opacity-100 transition-opacity">
						{data.pillars.cards.server.linkText}
					</span>
				</a>

				<!-- Router Card -->
				<a href="/router" class="group block p-6 transition-all duration-300 hover:-translate-y-1 rounded-[15px] border border-border bg-surface">
					<h3 class="text-lg font-bold group-hover:text-accent transition-colors mb-2">router</h3>
					<p class="text-sm text-secondary leading-relaxed mb-4">
						{data.pillars.cards.router.description}
					</p>
					<span class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-primary opacity-60 group-hover:opacity-100 transition-opacity">
						{data.pillars.cards.router.linkText}
					</span>
				</a>

				<!-- Learn Card -->
				<a href="/learn" class="group block p-6 transition-all duration-300 hover:-translate-y-1 rounded-[15px] border border-border bg-surface">
					<h3 class="text-lg font-bold group-hover:text-accent transition-colors mb-2">learn</h3>
					<p class="text-sm text-secondary leading-relaxed mb-4">
						{data.pillars.cards.learn.description}
					</p>
					<span class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-primary opacity-60 group-hover:opacity-100 transition-opacity">
						{data.pillars.cards.learn.linkText}
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- Developer Section -->
	<div class="wrap">
		<section class="border-t border-border py-12">
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-wider text-secondary">{data.developer.eyebrow}</p>
			<h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-bold tracking-tight mb-4">
				{data.developer.title}
			</h2>
			<p class="max-w-[620px] leading-[1.7] text-secondary text-[1.125rem]">
				{data.developer.description}
			</p>

			<div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-3">
				{data.developer.features.map((feat) => (
					<div class="p-6 rounded-[15px] border border-border bg-surface">
						<h3 class="text-lg font-bold mb-2">{feat.title}</h3>
						<p class="text-sm text-secondary leading-relaxed">
							{feat.description}
						</p>
					</div>
				))}
			</div>

			<!-- Privacy Guarantee Banner -->
			<div class="mt-16 rounded-[15px] bg-primary p-8 text-bg border border-primary shadow-xl transition-all duration-300">
				<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
					<p class="max-w-[700px] text-[clamp(1.125rem,2.2vw,1.375rem)] font-medium leading-[1.6] opacity-95">
						<strong class="font-extrabold opacity-100">{data.developer.privacyBanner.split(". ")[0]}.</strong>
						{data.developer.privacyBanner.split(". ").slice(1).join(". ")}
					</p>
				</div>
			</div>
		</section>
	</div>

	<!-- Licensing & Costs Section -->
	<div class="wrap">
		<section class="border-t border-border py-12">
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-wider text-secondary">{data.license.eyebrow}</p>
			<h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-bold tracking-tight mb-4">
				{data.license.title}
			</h2>
			<p class="max-w-[620px] leading-[1.7] text-secondary text-[1.125rem]">
				{data.license.description}
			</p>

			<div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-3">
				{data.license.points.map((pt) => (
					<div class="p-6 rounded-[15px] border border-border bg-surface relative flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between gap-2 mb-3">
								<h3 class="text-lg font-bold">{pt.title}</h3>
								<span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] font-bold bg-border/60 text-primary border border-border">
									{pt.badge}
								</span>
							</div>
							<p class="text-sm text-secondary leading-relaxed">
								{pt.description}
							</p>
						</div>
					</div>
				))}
			</div>

			<div class="mt-8 rounded-[15px] border border-border bg-surface/60 p-6 text-sm text-secondary leading-relaxed">
				<p><strong class="text-primary font-semibold">Note:</strong> {data.license.note}</p>
			</div>
		</section>
	</div>

	<!-- Waitlist CTA Section -->
	<div class="wrap" id="waitlist">
		<section class="border-t border-border py-12">
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-wider text-secondary">{data.waitlist.eyebrow}</p>
			<h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-bold tracking-tight mb-4">{data.waitlist.title}</h2>
			<p class="max-w-[620px] leading-[1.7] text-secondary text-[1.125rem] mb-8">
				{data.waitlist.description}
			</p>
			<div class="flex max-w-[480px]">
				<WaitlistForm />
			</div>

			<div class="pt-10 flex flex-wrap gap-4">
				<a class="inline-flex items-center gap-1.5 font-mono text-xs text-weak transition-colors hover:text-accent" href="https://github.com/hirnlabs/hirn" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
					<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.92.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path></svg>
					GitHub
				</a>
				<a class="inline-flex items-center gap-1.5 font-mono text-xs text-weak transition-colors hover:text-accent" href="https://www.instagram.com/hirnlabs" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
					<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
					Instagram
				</a>
				<a class="inline-flex items-center gap-1.5 font-mono text-xs text-weak transition-colors hover:text-accent" href="https://www.linkedin.com/company/focccus-dev" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
					<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
					LinkedIn
				</a>
				<a class="inline-flex items-center gap-1.5 font-mono text-xs text-weak transition-colors hover:text-accent" href="https://www.youtube.com/@focccusdev" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
					<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg>
					YouTube
				</a>
				<a class="inline-flex items-center gap-1.5 font-mono text-xs text-weak transition-colors hover:text-accent" href="mailto:focccus@proton.me" aria-label="Email">
					<Mail class="h-3.5 w-3.5" size={14} />
					Email
				</a>
			</div>
		</section>
	</div>

	<!-- Script to control Video overlay -->
	<script>
		const playBtn = document.getElementById("play-btn");
		const heroImg = document.getElementById("hero-img");
		const heroVideo = document.getElementById("hero-video") as HTMLIFrameElement | null;

		if (playBtn && heroImg && heroVideo) {
			playBtn.addEventListener("click", () => {
				playBtn.style.display = "none";
				heroImg.style.visibility = "hidden";
				if (heroVideo.dataset.src) {
					heroVideo.src = heroVideo.dataset.src;
				}
				heroVideo.style.display = "block";
			});
		}
	</script>
</Layout>
