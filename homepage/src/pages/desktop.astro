---
import Layout from "../components/Layout.astro";
---

<Layout title="desktop - hirn" description="Standalone desktop app for Windows/Linux with browser access.">
  <div class="wrap py-12">
    <a href="/" class="group inline-flex items-center gap-2 mb-8 font-mono text-xs text-secondary hover:text-primary transition-colors">
      <svg class="h-4 w-4 transform transition-transform group-hover:-translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
      </svg>
      Back to system overview
    </a>

    <section class="mb-12 border-b border-border pb-10">
      <div class="flex items-center gap-4 mb-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-bg">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M8 20h8" />
            <path d="M12 16v4" />
          </svg>
        </div>
        <h1 class="text-[clamp(2rem,4vw,2.75rem)] font-bold tracking-tight">desktop</h1>
      </div>
      <p class="text-xl text-secondary max-w-[680px] leading-relaxed">
        The standalone desktop experience for hirn. Run as a native app on Windows or Linux, or access the same workspace through the browser client.
      </p>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="md:col-span-2 space-y-10 order-2 md:order-1">

        <div class="space-y-4">
          <h2 class="text-2xl font-bold">Standalone by default</h2>
          <p class="text-secondary leading-relaxed">
            Desktop runs as a native Tauri app with direct local process execution, so your sessions, tools, and outputs stay close to the machine where work happens.
          </p>
        </div>

        <div class="space-y-4">
          <h2 class="text-2xl font-bold">Cross-platform and browser-ready</h2>
          <p class="text-secondary leading-relaxed">
            Installers are available for Windows and Linux, and the web client mode connects through <code class="font-mono text-sm px-1 bg-surface border border-border rounded">hirn serve</code> when you prefer running in a browser.
          </p>
        </div>

      </div>

      <div class="space-y-4 order-1 md:order-2">
        <div class="p-6 border border-border rounded-xl">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider mb-2">Native + Web Modes</h3>
          <p class="text-sm text-secondary leading-relaxed">
            Use the native desktop transport for local execution, or switch to browser mode when you want remote access to the same agent stack.
          </p>
        </div>
        <div class="p-6 border border-border rounded-xl">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider mb-2">Shared Sessions</h3>
          <p class="text-sm text-secondary leading-relaxed">
            Session history is shared with the CLI under <code class="font-mono text-sm px-1 bg-surface border border-border rounded">~/.hirn/sessions/</code> so work continues seamlessly between terminal and desktop.
          </p>
        </div>
        <div class="p-6 border border-border rounded-xl">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider mb-2">Always Local-First</h3>
          <p class="text-sm text-secondary leading-relaxed">
            Whether native or browser-based, desktop keeps private state local-first and remains usable even when the wider network is unavailable.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
